# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o arquivo ".env" — ele já está no .gitignore.

FLASK_ENV=production
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# Gere com: flask generate-key
ENCRYPTION_KEY=troque-por-uma-chave-fernet-gerada

# Caminho do banco (padrão: instance/power_central.db). Só ajuste se souber o que está fazendo.
# DATABASE_URL=sqlite:///C:/power_central/instance/power_central.db

# Credenciais da conta de integração (somente-leitura) do portal SoftGuard
SOFTGUARD_HOST=sistemas.powercentral.com.br
SOFTGUARD_PORT=8020
SOFTGUARD_CLIENT_ID=
SOFTGUARD_USERNAME=
SOFTGUARD_PASSWORD=

LOG_LEVEL=INFO
# LOG_DIR=C:/power_central/logs

SESSION_COOKIE_SECURE=false

# Liga o coletor automático (ciclo de 5 min, watchdog, relatório periódico,
# retenção). Deixe "false" aqui: o serviço Windows já liga isso sozinho
# (scripts/install_service.ps1), e comandos de CLI (migrations, seed-admin)
# não devem ligar o agendador. Para testar com "flask run", ligue só na
# janela atual do PowerShell, sem editar este arquivo:
#   $env:START_SCHEDULER = "true"
#   .venv\Scripts\python.exe -m flask run --no-reload
START_SCHEDULER=false
